# Copy this file to .env and fill in. One channel is enough (or both).
# Do not put comments on the same line as a value.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# comma separated; groups start with -100
TELEGRAM_CHAT_IDS=

# --- WhatsApp via green-api.com ---
GREENAPI_ID_INSTANCE=
GREENAPI_API_TOKEN=
# group: 1234567890-1234567890@g.us   private chat: 9725XXXXXXXX@c.us
GREENAPI_CHAT_IDS=
# default is https://api.greenapi.com ; some instances show a different apiUrl in the console
# GREENAPI_API_URL=

# --- Optional generic webhook (Discord/Slack/ntfy...) ---
# WEBHOOK_URL=
